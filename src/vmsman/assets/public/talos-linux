# Template file for 'talos-linux'
OSNAME="talos-linux"
PRETTY="Talos Linux"
LOGO=""
ICON="talos-linux.svg"
ICON_ONLINE=""
CATEGORY="Server, Advanced"
BASEDOF="-"
DESCRIPTION="Minimal, immutable Kubernetes OS. The ISO boots into maintenance mode; installation requires applying a machine configuration with talosctl"
HOMEPAGE="https://www.talos.dev/"
CREDENTIALS=""
GPG=""
RSS="https://raw.githubusercontent.com/oSoWoSo/distro-feeds/public/releases.xml"
DW="https://distrowatch.com/talos"
MAGNET=""
MAGNET_PREFERRED=""
TORRENT=""
CHAT=""
GUEST="linux"

RELEASES="1.15.0-beta.0 1.15.0-alpha.2 1.15.0-alpha.1 1.15.0-alpha.0 1.14.6 1.14.5 1.14.4 1.14.3 1.14.2 1.14.1 1.14.0-rc.2 1.14.0-rc.1 1.14.0-beta.1 1.14.0-beta.0 1.14.0-alpha.2 1.14.0-alpha.1 1.14.0 1.13.9 1.13.8 1.13.7 1.13.6 1.13.5 1.13.4 1.13.12 1.13.11 1.13.10 1.12.9 1.12.12 1.12.11 1.12.10"
QEMU_ARCH="amd64 arm64"

arch_() {
	echo amd64 arm64
}

releases_() {
	local VERSIONS
	VERSIONS=$(atom_feed_iso_entries "${RSS}" "${DW##*/}" \
		| awk -F '\t' '
			{
				release = $1
				if (release ~ /-alpha[0-9]+$/) sub(/-alpha/, "-alpha.", release)
				print release
			}
		' \
		| sort -Vr)
	if [ -n "${VERSIONS}" ]; then
		printf '%s\n' "${VERSIONS}"
	else
		# The third-party feed may not contain Talos. Use published release assets.
		web_pipe_json "https://api.github.com/repos/siderolabs/talos/releases" \
			| jq -r --arg asset "metal-${ARCH:-amd64}.iso" '
				.[] | select(.draft != true and any(.assets[]?; .name == $asset))
				| .tag_name | ltrimstr("v")' | sort -Vr
	fi
}

get_() {
	local TALOS_ARCH="${ARCH:-amd64}"
	local TALOS_RELEASE="${RELEASE}"
	local ISO_URL=""
	local HASH=""
	if [[ "${TALOS_RELEASE}" =~ ^(.+-alpha)([0-9]+)$ ]]; then
		TALOS_RELEASE="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}"
	fi
	case "${TALOS_ARCH}" in
		amd64)
			ISO_URL=$(atom_feed_iso_entries "${RSS}" "${DW##*/}" \
				| awk -F '\t' -v release="${TALOS_RELEASE}" '
					{
						upstream_release = $1
						if (upstream_release ~ /-alpha[0-9]+$/) sub(/-alpha/, "-alpha.", upstream_release)
						if (upstream_release == release) { print $2; exit }
					}
				')
			;;
		arm64) ;;
		*) return 1 ;;
	esac
	[ -n "${ISO_URL}" ] || ISO_URL="https://github.com/siderolabs/talos/releases/download/v${TALOS_RELEASE}/metal-${TALOS_ARCH}.iso"
	HASH=$(web_pipe_json "https://api.github.com/repos/siderolabs/talos/releases/tags/v${TALOS_RELEASE}" \
		| jq -r --arg asset "metal-${TALOS_ARCH}.iso" \
			'.assets[]? | select(.name == $asset) | (.digest // "") | select(startswith("sha256:")) | sub("^sha256:"; "")')
	echo "${ISO_URL} ${HASH}"
}

releases_() {
	# Releases parsed at generation time — no network access needed.
	echo "${RELEASES}"
}
