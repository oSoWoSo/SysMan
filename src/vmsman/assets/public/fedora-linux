_release_editions_() {
	case "${1:-}" in
		"ppc64el|45")	 echo "KDE Server" ;;
		"ppc64el|44")	 echo "KDE Server Workstation" ;;
		"ppc64el|43")	 echo "KDE Server Workstation" ;;
		"amd64|43")	 echo "Budgie Cinnamon COSMIC COSMIC-Atomic i3 KDE KDE_Mobile Kinoite LXDE LXQt Mate MiracleWM Onyx Sericea Server Silverblue Sway Workstation Xfce" ;;
		"amd64|45")	 echo "Budgie Budgie-Atomic Cinnamon COSMIC COSMIC-Atomic i3 KDE KDE_Mobile Kinoite LXDE LXQt Mate MiracleWM Server Silverblue Sway Sway-Atomic Workstation Xfce" ;;
		"amd64|44")	 echo "Budgie Cinnamon COSMIC COSMIC-Atomic i3 KDE KDE_Mobile Kinoite LXDE LXQt Mate MiracleWM Onyx Sericea Server Silverblue Sway Workstation Xfce" ;;
		"arm64|45")	 echo "COSMIC COSMIC-Atomic i3 KDE KDE_Mobile Kinoite LXQt MiracleWM Server Silverblue Workstation Xfce" ;;
		"arm64|44")	 echo "COSMIC COSMIC-Atomic i3 KDE KDE_Mobile Kinoite LXQt MiracleWM Server Silverblue Workstation Xfce" ;;
		"arm64|43")	 echo "COSMIC COSMIC-Atomic i3 KDE KDE_Mobile Kinoite LXQt MiracleWM Server Silverblue Workstation Xfce" ;;
